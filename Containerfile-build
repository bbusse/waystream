FROM rust:alpine3.21 AS builder
LABEL maintainer="Björn Busse <bj.rn@baerlin.eu>"
LABEL org.opencontainers.image.source https://github.com/bbusse/waystream

ARG TARGET=""

ENV USER="build-user"

# Build dependencies for musl/alpine + GStreamer
RUN apk add --no-cache \
    build-base \
    pkgconfig \
    glib-dev \
    gstreamer-dev \
    gst-plugins-base-dev \
    gettext-dev

WORKDIR /usr/local/src/waystream
COPY . .

# Avoid full static linking on musl (no static GStreamer libs available)
RUN mkdir -p .cargo \
  && printf "[target.aarch64-unknown-linux-musl]\nrustflags = [\"-C\", \"target-feature=-crt-static\"]\n\n[target.x86_64-unknown-linux-musl]\nrustflags = [\"-C\", \"target-feature=-crt-static\"]\n" > .cargo/config.toml

RUN cargo build --release $TARGET \
  && install -Dm755 "$(find target -maxdepth 3 -type f -name waystream -path '*/release/waystream')" /out/waystream

FROM alpine:3.21 AS runtime
LABEL maintainer="Björn Busse <bj.rn@baerlin.eu>"
LABEL org.opencontainers.image.source https://github.com/bbusse/waystream

ENV USER="waystream"

# Runtime libraries for GStreamer + GLib
RUN apk add --no-cache \
    gstreamer \
    gst-plugins-base \
    glib \
    gettext-libs

# Add application user
RUN addgroup -S $USER && adduser -S $USER -G $USER

# Copy binary from builder
COPY --from=builder /out/waystream /usr/local/bin/waystream

USER $USER
ENTRYPOINT ["/usr/local/bin/waystream"]
